---
// Prototype B, "Viewfinder": one small frame on the empty sheet, hard-cutting through real
// footage (builds, boards, trips). The cursor nudges it; scrolling travels into it until it fills
// the sheet, then the site begins.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import reel from '../data/reel.json';
import poster from '../assets/media/hero/reel.jpg';

const p = await getImage({ src: poster, width: 640, format: 'webp' });
const total = String(reel.cuts.length).padStart(2, '0');
---

<Base title="Hero B — Viewfinder" noindex>
  <section class="vf" data-vf data-sheet="01" data-sheet-title="General arrangement">
    <div class="vf__stage">
      <h1 class="visually-hidden">Orhun Habib Erdogan, mechatronics engineer in Eindhoven</h1>
      <div class="vf__frame" data-vf-frame>
        <div class="vf__clip">
          <video muted playsinline loop autoplay preload="auto" poster={p.src} data-vf-video aria-hidden="true">
            <source src="/media/hero/reel.webm" type="video/webm" />
            <source src="/media/hero/reel.mp4" type="video/mp4" />
          </video>
        </div>
        <span class="vf__mark vf__mark--tl" aria-hidden="true"></span>
        <span class="vf__mark vf__mark--tr" aria-hidden="true"></span>
        <span class="vf__mark vf__mark--bl" aria-hidden="true"></span>
        <span class="vf__mark vf__mark--br" aria-hidden="true"></span>
      </div>
      <div class="vf__caption mono" data-vf-caption aria-hidden="true">
        <span><span class="accent" data-vf-n>01</span><span class="mono-meta">/{total}</span></span>
        <span data-vf-label>{reel.cuts[0].label}</span>
        <span class="mono-meta" data-vf-where>{reel.cuts[0].where}</span>
      </div>
      <a class="vf__cue mono" href="#status">↓ Scroll in</a>
    </div>
  </section>
  <Status />
</Base>

<script>
  import { reducedMotion, finePointer } from '../scripts/env';
  import reel from '../data/reel.json';

  const section = document.querySelector<HTMLElement>('[data-vf]')!;
  const frame = section.querySelector<HTMLElement>('[data-vf-frame]')!;
  const video = section.querySelector<HTMLVideoElement>('[data-vf-video]')!;
  const caption = section.querySelector<HTMLElement>('[data-vf-caption]')!;
  const nEl = section.querySelector<HTMLElement>('[data-vf-n]')!;
  const labelEl = section.querySelector<HTMLElement>('[data-vf-label]')!;
  const whereEl = section.querySelector<HTMLElement>('[data-vf-where]')!;
  const reduced = reducedMotion();

  if (reduced) {
    video.removeAttribute('autoplay');
    video.pause();
  }

  // caption follows the cut that's on screen
  let lastCut = -1;
  const syncCaption = () => {
    const i = Math.min(reel.cuts.length - 1, Math.floor(video.currentTime / reel.seg));
    if (i !== lastCut) {
      lastCut = i;
      nEl.textContent = String(i + 1).padStart(2, '0');
      labelEl.textContent = reel.cuts[i].label;
      whereEl.textContent = reel.cuts[i].where;
    }
  };
  const v = video as HTMLVideoElement & { requestVideoFrameCallback?: (cb: () => void) => void };
  if (v.requestVideoFrameCallback) {
    const tick = () => {
      syncCaption();
      v.requestVideoFrameCallback!(tick);
    };
    v.requestVideoFrameCallback(tick);
  } else video.addEventListener('timeupdate', syncCaption);

  // scroll: travel into the frame (scale it up until it covers the sheet). transform only.
  let scroll = 0,
    nx = 0,
    ny = 0,
    px = 0,
    py = 0,
    raf = 0;
  let scaleMax = 4;
  const measure = () => {
    frame.style.transform = '';
    const r = frame.getBoundingClientRect();
    scaleMax = Math.max(innerWidth / r.width, innerHeight / r.height) * 1.02;
  };
  measure();
  addEventListener('resize', () => {
    measure();
    kick();
  });

  const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
  function frameLoop() {
    raf = 0;
    px += (nx - px) * 0.08;
    py += (ny - py) * 0.08;
    const k = ease(Math.min(1, scroll / 0.8));
    const s = 1 + (scaleMax - 1) * k;
    const drift = 1 - k; // parallax fades out as we go in
    frame.style.transform = `translate3d(${(px * 14 * drift).toFixed(2)}px, ${(py * 10 * drift).toFixed(2)}px, 0) scale(${s.toFixed(4)})`;
    caption.style.opacity = String(Math.max(0, 1 - scroll * 4));
    if (Math.abs(nx - px) > 0.001 || Math.abs(ny - py) > 0.001) raf = requestAnimationFrame(frameLoop);
  }
  const kick = () => {
    if (!raf) raf = requestAnimationFrame(frameLoop);
  };

  if (!reduced) {
    addEventListener(
      'scroll',
      () => {
        const r = section.getBoundingClientRect();
        scroll = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
        kick();
      },
      { passive: true },
    );
    if (finePointer())
      addEventListener('pointermove', (e) => {
        nx = (e.clientX / innerWidth) * 2 - 1;
        ny = (e.clientY / innerHeight) * 2 - 1;
        kick();
      });
  }
  new IntersectionObserver(([e]) => (e.isIntersecting && !reduced ? video.play().catch(() => {}) : video.pause())).observe(section);
</script>

<style>
  .vf {
    position: relative;
    height: 230svh;
  }
  .vf__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    display: grid;
    place-items: center;
  }
  .vf__frame {
    position: relative;
    width: min(30vw, 42svh);
    aspect-ratio: 4 / 5;
    transform-origin: 50% 50%;
    will-change: transform;
  }
  .vf__clip {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--bg-raised);
  }
  .vf__clip video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* crop marks, just outside the frame */
  .vf__mark {
    position: absolute;
    width: 14px;
    height: 14px;
    border-color: var(--ink);
    border-style: solid;
    border-width: 0;
  }
  .vf__mark--tl {
    left: -10px;
    top: -10px;
    border-left-width: 1px;
    border-top-width: 1px;
  }
  .vf__mark--tr {
    right: -10px;
    top: -10px;
    border-right-width: 1px;
    border-top-width: 1px;
  }
  .vf__mark--bl {
    left: -10px;
    bottom: -10px;
    border-left-width: 1px;
    border-bottom-width: 1px;
  }
  .vf__mark--br {
    right: -10px;
    bottom: -10px;
    border-right-width: 1px;
    border-bottom-width: 1px;
  }
  .vf__caption {
    position: absolute;
    left: 50%;
    top: calc(50% + min(15vw, 21svh) * 1.25 + 1.6rem);
    transform: translateX(-50%);
    display: flex;
    gap: 1rem;
    white-space: nowrap;
    font-size: 10.5px;
  }
  .vf__cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--frame) + 2.4rem);
    transform: translateX(-50%);
    text-decoration: none;
    font-size: 10px;
    color: var(--accent-text);
  }
  @media (max-width: 760px) {
    .vf__frame {
      width: min(62vw, 48svh);
    }
    .vf__caption {
      top: calc(50% + min(31vw, 24svh) * 1.25 + 1.4rem);
      flex-direction: column;
      align-items: center;
      gap: 0.2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .vf {
      height: 100svh;
    }
  }
</style>
