---
import Base from '../layouts/Base.astro';
import { roles, education, skills, certificates, languages } from '../data/work';

---

<Base
  title="Work"
  description="Work history of Orhun Habib Erdogan: controls commissioning at Vanderlande, ROS2 and C++ at WeFabricate, BLDC drivers at Fyllar, robot software at Team Pi."
  sheet={{ no: 'W-01', title: 'Work history' }}
>
  <div class="work wrap">
    <nav class="mono" aria-label="Breadcrumb"><a class="link-draw" href="/#work">← Home</a></nav>

    <header class="work__head">
      <p class="mono"><span class="accent">Sheet W-01</span> <span class="mono-meta">· Work history · Rev 23</span></p>
      <h1 class="work__title display">The professional bit, in full.</h1>
      <p class="work__lede">
        Software that makes real machines move: PLCs on site, ROS2 and C++ in the lab, drivers written from datasheets.
        Currently between jobs on purpose and open to freelance work that’s actually interesting.
      </p>
      <div class="work__ctas">
        <a class="btn" href="/cv/orhun-habib-erdogan-cv.pdf" download data-magnetic="0.2">Download CV <span class="mono-meta">PDF</span></a>
        <a class="btn" href="/cv" data-magnetic="0.2">Web CV</a>
        <a class="btn" href="/#contact" data-magnetic="0.2">Get in touch</a>
      </div>
    </header>

    <section aria-labelledby="roles-h">
      <h2 id="roles-h" class="sheet-head mono">
        <span class="accent">01</span><span>Roles</span><span class="mono-meta">Each one has its own sheet</span>
      </h2>
      <ol class="roles" role="list">
        {
          roles.map((r, i) => (
            <li>
              <a class="row" href={`/work/${r.id}`}>
                <span class="row__code mono accent">W-{String(i + 1).padStart(2, '0')}</span>
                <span class="row__when mono mono-meta">
                  {r.from} – {r.to}
                </span>
                <span class="row__what">
                  <span class="row__org">{r.org}</span>
                  <span class="row__title">{r.title}</span>
                </span>
                <span class="row__sum">{r.summary}</span>
                <span class="row__go" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>


    <div class="work__grid">
      <section aria-labelledby="skills-h">
        <h2 id="skills-h" class="sheet-head mono"><span class="accent">02</span><span>Skills</span></h2>
        <p class="skills">{skills.join(' · ')}</p>
      </section>

      <section aria-labelledby="edu-h">
        <h2 id="edu-h" class="sheet-head mono"><span class="accent">03</span><span>Education</span></h2>
        <p class="edu__deg">{education.degree}</p>
        <p class="mono mono-meta">{education.school} · {education.years}</p>
        <p class="edu__note">{education.note}</p>
      </section>

      <section aria-labelledby="cert-h">
        <h2 id="cert-h" class="sheet-head mono"><span class="accent">04</span><span>Certificates</span></h2>
        <ul class="plain" role="list">{certificates.map((c) => <li>{c}</li>)}</ul>
      </section>

      <section aria-labelledby="lang-h">
        <h2 id="lang-h" class="sheet-head mono"><span class="accent">05</span><span>Languages</span></h2>
        <dl class="langs">
          {
            languages.map((l) => (
              <div>
                <dt>{l.name}</dt>
                <dd class="mono mono-meta">{l.level}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</Base>

<style>
  .work {
    padding-top: calc(var(--frame) + 6rem);
    padding-bottom: calc(var(--frame) + 5rem);
  }
  .work__head {
    margin-block: var(--space-l) var(--space-xl);
  }
  .work__title {
    font-size: var(--step-5);
    letter-spacing: -0.045em;
    margin-block: 0.75rem 1.25rem;
    max-width: 12ch;
  }
  .work__lede {
    font-size: var(--step-1);
    color: var(--ink-2);
    max-width: 52ch;
  }
  .work__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-l);
  }

  .roles {
    margin-bottom: var(--space-xl);
  }
  .row {
    display: grid;
    grid-template-columns: 6ch 19ch minmax(0, 1.1fr) minmax(0, 1fr) 2ch;
    gap: 1rem;
    align-items: baseline;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    position: relative;
  }
  .row::before {
    content: '';
    position: absolute;
    inset: 0 -1rem;
    background: var(--bg-raised);
    opacity: 0;
    z-index: -1;
    transition: opacity var(--dur-hover) ease;
  }
  .row__what {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 0.9rem;
  }
  .row__org {
    font-size: var(--step-2);
    font-weight: 750;
    letter-spacing: -0.025em;
    transition: color var(--dur-hover) ease;
  }
  .row__title,
  .row__sum {
    color: var(--ink-2);
  }
  .row__sum {
    font-size: var(--step--1);
  }
  .row__go {
    color: var(--accent-text);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .row:hover::before {
      opacity: 1;
    }
    .row:hover .row__org {
      color: var(--accent-text);
    }
    .row:hover .row__go {
      transform: translateX(6px);
    }
  }

  .work__grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: var(--space-l) clamp(2rem, 5vw, 5rem);
  }
  .skills {
    font-size: var(--step-1);
    line-height: 1.6;
    padding-top: 0.75rem;
  }
  .edu__deg {
    font-size: var(--step-1);
    font-weight: 650;
    padding-top: 0.75rem;
  }
  .edu__note {
    margin-top: 0.4rem;
    color: var(--ink-2);
  }
  .plain {
    list-style: none;
    padding: 0.75rem 0 0;
    display: grid;
    gap: 0.4rem;
  }
  .langs {
    padding-top: 0.5rem;
  }
  .langs div {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0;
    border-bottom: 1px solid var(--line);
  }

  @media (max-width: 860px) {
    .row {
      grid-template-columns: 5ch 1fr 2ch;
      gap: 0.3rem 0.75rem;
    }
    .row__when {
      grid-column: 2;
      grid-row: 1;
    }
    .row__what,
    .row__sum {
      grid-column: 2;
    }
    .row__go {
      grid-column: 3;
      grid-row: 1;
    }
    .work__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
