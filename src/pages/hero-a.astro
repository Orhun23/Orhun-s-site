---
// Prototype A, "Contact sheet": everything at once. A tilted wall of frames (builds, boards,
// trips) drifts slowly up the sheet like a contact sheet on a light table. Frames are printed
// in graphite; the one under the cursor (or finger) develops into colour and, if it's a clip,
// plays. Scrolling lays the wall flat and the site begins.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';

const m = import.meta.glob<{ default: ImageMetadata }>('../assets/media/**/*.jpg', { eager: true });
const img = (p: string) => m[`../assets/media/${p}.jpg`].default;

type Tile = { src: string; tag: string; label: string; video?: string };
const raw: [string, string, string, string?][] = [
  ['builds/tallbike/riding', 'B-01', 'Tallbike', '/media/builds/tallbike/riding.mp4'],
  ['trips/rinjani-ridge', 'T-01', 'Rinjani 8.41°S'],
  ['field/snow-jump', 'S-02', 'Snow', '/media/field/snow-jump.mp4'],
  ['builds/helmet/clean', 'B-02', 'Iron Man helmet'],
  ['trips/osaka-night', 'T-02', 'Osaka'],
  ['field/skate-trocadero', 'S-01', 'Trocadéro', '/media/field/skate-trocadero.mp4'],
  ['builds/xwing/clean', 'B-03', 'X-wing'],
  ['trips/sahara', 'T-03', 'Sahara'],
  ['builds/printer/printing', 'B-04', '3D printer', '/media/builds/printer/printing.mp4'],
  ['field/surf', 'S-03', 'Surf, Lombok'],
  ['trips/fuji-summit', 'T-02', 'Fuji 3776 m'],
  ['builds/tallbike/welding', 'B-01', 'Welding', '/media/builds/tallbike/welding.mp4'],
  ['field/skate-bowl-air', 'S-01', 'Taghazout bowl'],
  ['trips/fogo', 'T-04', 'Fogo'],
  ['builds/helmet/faceplate', 'B-02', 'Faceplate servo', '/media/builds/helmet/faceplate.mp4'],
  ['field/backfull', 'S-04', 'Backfull', '/media/field/backfull.mp4'],
  ['trips/jaipur-wall', 'T-05', 'Jaipur'],
  ['builds/xwing/exploded', 'B-03', 'Exploded view'],
  ['field/snow-spray', 'S-02', 'Powder'],
  ['trips/todra-gorge', 'T-03', 'Todra gorge'],
  ['trips/whale-shark', 'T-01', 'Whale shark', '/media/trips/whale-shark.mp4'],
  ['builds/printer/frame-cad', 'B-04', 'Frame CAD'],
  ['trips/black-beach', 'T-04', 'Black beach'],
  ['builds/tallbike/jig', 'B-01', 'On the jig'],
];
const tiles: Tile[] = await Promise.all(
  raw.map(async ([path, tag, label, video]) => {
    const r = await getImage({ src: img(path), width: 360, height: 450, fit: 'cover', format: 'webp' });
    return { src: r.src, tag, label, video };
  }),
);
const COLS = 6;
// columns, each drifting at its own speed; the list is repeated so the loop is seamless
const cols = Array.from({ length: COLS }, (_, c) => tiles.filter((_, i) => i % COLS === c));
---

<Base title="Hero A — Contact sheet" noindex>
  <section class="cs" data-cs data-sheet="01" data-sheet-title="General arrangement">
    <div class="cs__stage">
      <h1 class="visually-hidden">Orhun Habib Erdogan, mechatronics engineer in Eindhoven</h1>
      <div class="cs__wall" data-cs-wall aria-hidden="true">
        {
          cols.map((col, c) => (
            <div class="cs__col" style={`--d:${46 + ((c * 7) % 5) * 6}s;--o:${-((c * 37) % 100) / 100}`}>
              <div class="cs__track">
                {[...col, ...col, ...col, ...col].map((t, i) => (
                  <figure class="cs__tile" data-video={t.video}>
                    <img src={t.src} alt="" width="360" height="450" loading={i < 8 ? 'eager' : 'lazy'} decoding="async" />
                    <figcaption class="mono">
                      <span class="accent">{t.tag}</span> {t.label}
                    </figcaption>
                  </figure>
                ))}
              </div>
            </div>
          ))
        }
      </div>
      <a class="cs__cue mono" href="#status">↓ Scroll</a>
    </div>
  </section>
  <Status />
</Base>

<script>
  import { reducedMotion } from '../scripts/env';

  const section = document.querySelector<HTMLElement>('[data-cs]')!;
  const wall = section.querySelector<HTMLElement>('[data-cs-wall]')!;
  const reduced = reducedMotion();

  // one shared <video>, moved into whichever clip tile is active: never more than one decoding
  const player = document.createElement('video');
  player.muted = true;
  player.loop = true;
  player.playsInline = true;
  player.className = 'cs__vid';
  let active: HTMLElement | null = null;
  const activate = (tile: HTMLElement | null) => {
    if (tile === active) return;
    active?.classList.remove('is-on');
    active = tile;
    if (!tile) {
      player.pause();
      player.remove();
      return;
    }
    tile.classList.add('is-on');
    const v = tile.dataset.video;
    if (v && !reduced) {
      if (!player.src.endsWith(v)) player.src = v;
      tile.appendChild(player);
      player.play().catch(() => {});
    } else {
      player.pause();
      player.remove();
    }
  };
  wall.addEventListener('pointerover', (e) => activate((e.target as Element).closest<HTMLElement>('.cs__tile')));
  wall.addEventListener('pointerleave', () => activate(null));

  // touch screens have no hover: every so often the frame in the middle of the screen develops
  if (!matchMedia('(hover: hover)').matches && !reduced) {
    let i = 0;
    setInterval(() => {
      if (section.classList.contains('is-off') || scrollY > innerHeight * 0.3) return;
      const x = innerWidth * (0.3 + 0.4 * (i++ % 2)),
        y = innerHeight * (0.38 + 0.12 * (i % 3));
      activate(document.elementFromPoint(x, y)?.closest<HTMLElement>('.cs__tile') ?? null);
    }, 1800);
  }

  // scroll: the tilted wall lays flat and dims as the first section comes up (transform/opacity)
  if (!reduced) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const r = section.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
          wall.style.setProperty('--p', p.toFixed(3));
          if (p > 0.05 && active) activate(null);
        });
      },
      { passive: true },
    );
  }
  // offscreen: stop the drift entirely
  new IntersectionObserver(([e]) => section.classList.toggle('is-off', !e.isIntersecting)).observe(section);
</script>

<style>
  .cs {
    position: relative;
    height: 180svh;
  }
  .cs__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    perspective: 1400px;
  }
  .cs__wall {
    --p: 0;
    position: absolute;
    inset: -30% -8% -30% -8%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(10px, 1.4vw, 22px);
    padding-inline: 2vw;
    transform: rotateX(calc(26deg * (1 - var(--p)))) rotateZ(calc(-6deg * (1 - var(--p)))) translateY(calc(var(--p) * -12%)) scale(calc(1 - var(--p) * 0.08));
    transform-origin: 50% 40%;
    opacity: calc(1 - var(--p) * 0.75);
    will-change: transform;
  }
  .cs__col {
    overflow: visible;
  }
  .cs__track {
    display: grid;
    gap: clamp(10px, 1.4vw, 22px);
    animation: drift var(--d) linear infinite;
    animation-delay: calc(var(--d) * var(--o));
  }
  .cs.is-off .cs__track {
    animation-play-state: paused;
  }
  @keyframes drift {
    to {
      transform: translateY(-50%);
    }
  }
  .cs__tile {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    background: var(--bg-raised);
  }
  .cs__tile img,
  .cs__tile :global(.cs__vid) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* printed in graphite, developed into colour on hover */
  .cs__tile img {
    filter: grayscale(1) contrast(1.05);
    opacity: 0.78;
    transition:
      filter 400ms ease,
      opacity 400ms ease;
  }
  .cs__tile.is-on img {
    filter: none;
    opacity: 1;
  }
  .cs__tile figcaption {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 4px;
    font-size: 9px;
    white-space: nowrap;
    color: var(--ink-3);
  }
  .cs__tile.is-on figcaption {
    color: var(--ink);
  }
  .cs__tile.is-on {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }
  .cs__cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--frame) + 2.4rem);
    transform: translateX(-50%);
    padding: 0.4rem 0.7rem;
    background: var(--bg);
    text-decoration: none;
    font-size: 10px;
    color: var(--accent-text);
  }
  @media (max-width: 760px) {
    .cs__wall {
      grid-template-columns: repeat(3, 1fr);
      inset: -30% -20% -30% -20%;
    }
    .cs__col:nth-child(n + 4) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cs__track {
      animation: none;
    }
    .cs {
      height: 100svh;
    }
  }
</style>
