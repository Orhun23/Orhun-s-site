---
// 1200×630 social card. Not linked anywhere: scripts/make-assets.mjs screenshots it to public/og.png.
import Base from '../layouts/Base.astro';
import { person } from '../data/site';
---

<Base title="OG" bare noindex>
  <div class="og">
    <div class="og__frame">
      <p class="og__meta mono">
        <span><span class="accent">Fig. 01</span> — {person.initials}, plotted</span>
        <span class="mono-meta">{person.coords} · Rev {person.age}</span>
      </p>
      <img class="og__plot" src="/media/hero/plot-static.png" alt="" />
      <p class="og__name mono">{person.name} <span class="mono-meta">— {person.role}, {person.base}</span></p>
    </div>
  </div>
</Base>

<style>
  .og {
    width: 1200px;
    height: 630px;
    padding: 18px;
    background: var(--paper);
    color: var(--graphite);
  }
  .og__frame {
    position: relative;
    height: 100%;
    border: 1px solid rgb(18 19 20 / 0.42);
    background-image:
      linear-gradient(rgb(18 19 20 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(18 19 20 / 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
  }
  .og__meta {
    position: absolute;
    top: 22px;
    left: 32px;
    right: 32px;
    display: flex;
    justify-content: space-between;
    font-size: 13px;
  }
  .og__copy {
    position: absolute;
    left: 32px;
    bottom: 32px;
  }
  .og__copy .mono {
    font-size: 13px;
    margin-bottom: 14px;
  }
  .og__plot {
    position: absolute;
    left: 0;
    right: 0;
    top: 30px;
    width: 100%;
    height: 560px;
    object-fit: cover;
    object-position: 50% 62%;
  }
  .og__name {
    position: absolute;
    left: 32px;
    bottom: 24px;
    font-size: 14px;
    padding: 4px 8px;
    background: var(--paper);
  }
  .og__meta {
    z-index: 1;
  }
</style>
