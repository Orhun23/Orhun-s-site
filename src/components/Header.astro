---
import { nav, person } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
---

<header class="header">
  <a class="brand press" href="/">
    <span class="brand__mark">{person.initials}</span>
    <span class="brand__name mono">{person.name}</span>
    <span class="visually-hidden">, home</span>
  </a>
  <nav aria-label="Main">
    <ul role="list" class="nav">
      {
        nav.map((item) => (
          <li>
            <a
              class="mono link-draw"
              href={item.href}
              aria-current={item.href === path ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <ThemeToggle />
</header>

<style>
  .header {
    position: fixed;
    top: var(--frame);
    left: var(--frame);
    right: var(--frame);
    z-index: 45;
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding: 0.7rem clamp(0.75rem, 1.6vw, 1.25rem);
    border-bottom: 1px solid var(--line);
    /* no backdrop blur: it repaints on every scroll frame and costs real time on phones */
    background: color-mix(in srgb, var(--bg) 94%, transparent);
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    text-decoration: none;
    margin-right: auto;
  }
  .brand__mark {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }
  .brand__name {
    color: var(--ink-3);
  }
  .nav {
    display: flex;
    gap: clamp(0.85rem, 2vw, 2rem);
  }
  .nav a {
    display: inline-block;
    padding-block: 0.35rem;
  }
  .nav a[aria-current='page'] {
    color: var(--accent-text);
  }
  /* small screens: name stays in the accessible name, just not on screen */
  @media (max-width: 860px) {
    .brand__name {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
  @media (max-width: 520px) {
    .header {
      gap: 0.6rem;
      padding-inline: 0.6rem;
    }
    .nav {
      gap: 0.7rem;
    }
    .nav a {
      font-size: 10px;
      letter-spacing: 0;
    }
  }
  @media (max-width: 360px) {
    .nav {
      gap: 0.5rem;
    }
    .nav a {
      font-size: 9.5px;
    }
  }
</style>
