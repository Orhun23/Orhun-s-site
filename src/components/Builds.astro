---
import { getCollection } from 'astro:content';
import Inspector from './Inspector.astro';

const builds = (await getCollection('builds')).sort((a, b) => a.data.order - b.data.order);
const inspected = builds.filter((b) => b.data.model && b.data.cover);
const rest = builds.filter((b) => !(b.data.model && b.data.cover));
---

<section id="builds" class="bench on-bench" data-sheet="03" data-sheet-title="Builds — inspection">
  <div class="bench__intro wrap">
    <header class="sheet-head mono">
      <span class="accent">Sheet 03</span>
      <span>Builds — inspection bench</span>
      <span class="mono-meta">{builds.length} items · none of them were assigned</span>
    </header>
    <h2 class="bench__title display">
      Things nobody<br />asked me to build.
    </h2>
    <p class="bench__lede">
      Scroll to put each one together. Every build starts as an exploded drawing, gets assembled part by part, measured,
      and then scanned into the real thing. <span class="hint-fine">Move the cursor to turn the drawing, hover the photo to see through it.</span><span class="hint-touch">Drag the drawing to turn it, press and hold the photo to see through it.</span>
    </p>
    <ol class="bench__index mono" role="list">
      {
        inspected.map((b) => (
          <li>
            <a href={`#build-${b.id}`} class="link-draw">
              <span class="accent">{b.data.code}</span> {b.data.title}
            </a>
          </li>
        ))
      }
    </ol>
  </div>

  {inspected.map((b) => <Inspector build={b} />)}

  <div class="wrap bench__rest">
    {
      rest.map((b) => (
        <a class="build-mini" href={`/builds/${b.id}/`}>
          <span class="mono accent">{b.data.code}</span>
          <span class="build-mini__name display">{b.data.title}</span>
          <span class="build-mini__sum">{b.data.summary}</span>
          <span class="mono build-mini__open" aria-hidden="true">
            Open <span>→</span>
          </span>
        </a>
      ))
    }
  </div>
</section>

<script>
  import { initBench } from '../scripts/inspect/bench';
  initBench();
</script>

<style>
  .bench {
    position: relative;
    padding-bottom: var(--space-xl);
  }

  .bench__intro {
    padding-top: var(--space-xl);
  }
  .bench__title {
    font-size: var(--step-5);
    letter-spacing: -0.045em;
    margin-block: var(--space-l) var(--space-m);
  }
  .bench__lede {
    max-width: 52ch;
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .bench__index {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin-top: var(--space-l);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .bench :global(.insp) {
    scroll-margin-top: 0;
  }

  /* the lede says how to use the bench: cursor words on desktop, finger words on touch */
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }

  .bench__rest {
    margin-top: var(--space-l);
  }
  .build-mini {
    display: grid;
    grid-template-columns: auto auto 1fr auto;
    align-items: baseline;
    gap: 1.5rem;
    padding-block: 1.4rem;
    border-block: 1px solid var(--line-strong);
    text-decoration: none;
  }
  .build-mini__name {
    font-size: var(--step-2);
  }
  .build-mini__sum {
    color: var(--ink-2);
  }
  .build-mini__open span {
    display: inline-block;
    color: var(--accent-text);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .build-mini:hover .build-mini__open span {
      transform: translateX(6px);
    }
  }
  @media (hover: none) {
    .build-mini:global(.is-focus) .build-mini__open span {
      transform: translateX(6px);
    }
  }
  @media (max-width: 860px) {
    .build-mini {
      grid-template-columns: auto 1fr;
      gap: 0.4rem 1rem;
    }
    .build-mini__sum {
      grid-column: 1 / -1;
    }
  }
</style>
