---
// A looping, muted video "plate" with a FIG caption. Plays only while on screen,
// never autoplays for reduced motion, always has a pause button.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
  src: string;
  poster: ImageMetadata;
  alt: string;
  fig?: string;
  caption?: string;
  meta?: string;
  ratio?: string;
  class?: string;
}

const { src, poster, alt, fig, caption, meta, ratio = '9 / 16', class: cls } = Astro.props;
const p = await getImage({ src: poster, width: Math.min(poster.width, 900), format: 'webp' });
---

<figure class:list={['plate', cls]} data-plate>
  <div class="plate__frame" style={`aspect-ratio:${ratio}`} data-reveal="wipe">
    <video muted playsinline loop preload="none" poster={p.src} data-autoplay aria-label={alt}>
      <source src={src} type="video/mp4" />
    </video>
    <button class="plate-btn press" type="button" data-play aria-label="Play video" aria-pressed="false">
      <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"
        ><path class="i-play" d="M4 2.5v11l9-5.5z" fill="currentColor"></path><path
          class="i-pause"
          d="M4 2.5h3v11H4zM9 2.5h3v11H9z"
          fill="currentColor"></path></svg
      >
    </button>
    <slot />
  </div>
  {
    (fig || caption) && (
      <figcaption class="mono">
        {fig && <span class="accent">{fig}</span>}
        {fig && caption && ' — '}
        {caption}
        {meta && (
          <>
            <br />
            <span class="mono-meta">{meta}</span>
          </>
        )}
      </figcaption>
    )
  }
</figure>

<style>
  .plate__frame {
    position: relative;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
    overflow: hidden;
  }
  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  figcaption {
    margin-top: 0.6rem;
  }
</style>
