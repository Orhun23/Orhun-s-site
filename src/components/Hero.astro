---
import { getImage } from 'astro:assets';
import { site, person } from '../data/site';
import skatePoster from '../assets/media/hero/skate-trocadero.jpg';

const poster = await getImage({ src: skatePoster, width: 720, format: 'webp' });
const [line1, line2] = site.heroLine;
---

<section id="top" class="hero" data-sheet="01" data-sheet-title="General arrangement" data-hero>
  <div class="hero__stage">
    <div class="hero__meta mono">
      <span>Fig. 01 — Tallbike (B-01), <span data-hero-view>exploded view</span></span>
      <span class="hero__meta-r mono-meta">Scale 1:20 · Dims in “normal bikes”</span>
    </div>

    <div class="hero__canvas" data-hero-canvas></div>
    <div class="hero__overlay" data-hero-overlay aria-hidden="true"></div>

    <figure class="hero__plate" data-hero-plate data-plate>
      <video
        muted
        playsinline
        loop
        preload="none"
        data-poster={poster.src}
        width="720"
        height="1280"
        data-autoplay
        aria-label="Orhun skating a flat rail at the Trocadéro in Paris, the Eiffel Tower behind him"
      >
        <source src="/media/hero/skate-trocadero.mp4" type="video/mp4" />
      </video>
      <noscript><img class="hero__still" src={poster.src} alt="Orhun skating at the Trocadéro in Paris, the Eiffel Tower behind him" /></noscript>
      <button class="plate-btn press" type="button" data-play aria-label="Play video" aria-pressed="false">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"><path class="i-play" d="M4 2.5v11l9-5.5z" fill="currentColor"></path><path class="i-pause" d="M4 2.5h3v11H4zM9 2.5h3v11H9z" fill="currentColor"></path></svg>
      </button>
      <figcaption class="mono">
        <span class="accent">Fig. 02</span> — Detail B: the other half<br />
        <span class="mono-meta">Trocadéro, Paris · 48.86°N 2.29°E</span>
      </figcaption>
    </figure>

    <div class="hero__copy">
      <p class="hero__who mono">
        <span>{person.name}</span>
        <span class="mono-meta">— {person.role}, {person.base}</span>
      </p>
      <h1 class="hero__title display">
        <span class="hero__line">{line1}</span>
        <span class="hero__line hero__line--2" data-hero-line2>{line2}</span>
      </h1>
    </div>

    <p class="hero__cue mono" data-hero-cue aria-hidden="true">
      <span class="hero__cue-line"></span> Scroll to assemble
    </p>
  </div>
</section>

<script>
  import { reducedMotion, finePointer, cssVar } from '../scripts/env';

  const section = document.querySelector<HTMLElement>('[data-hero]')!;
  const canvasBox = section.querySelector<HTMLElement>('[data-hero-canvas]')!;
  const overlay = section.querySelector<HTMLElement>('[data-hero-overlay]')!;
  const plate = section.querySelector<HTMLElement>('[data-hero-plate]')!;
  const line2 = section.querySelector<HTMLElement>('[data-hero-line2]')!;
  const cue = section.querySelector<HTMLElement>('[data-hero-cue]')!;
  const view = section.querySelector<HTMLElement>('[data-hero-view]')!;
  const reduced = reducedMotion();
  const small = () => window.matchMedia('(max-width: 760px)').matches;


  // skate plate + line 2: driven by scroll (or shown outright for reduced motion)
  const video = plate.querySelector('video')!;
  // the plate is hidden until the end of the scroll story, so its poster can wait too
  const loadPoster = () => {
    if (!video.poster && video.dataset.poster) video.poster = video.dataset.poster;
  };
  const reveal = (r: number) => {
    plate.style.setProperty('--r', String(r));
    line2.style.setProperty('--r', String(r));
    const show = r > 0.02;
    if (show === plate.hasAttribute('data-shown')) return;
    plate.toggleAttribute('data-shown', show);
    if (show) loadPoster();
    // only decode video once it's actually visible
    if (show && !reduced && !video.dataset.userPaused) {
      video.preload = 'auto';
      video.play().catch(() => {});
    } else if (!show) {
      video.pause();
    }
  };

  async function boot() {
    if (!document.createElement('canvas').getContext) {
      section.classList.add('hero--static');
      return;
    }
    // everything heavy is fetched here, after first paint
    const [{ createHero }, { gsap }, { ScrollTrigger }] = await Promise.all([
      import('../scripts/hero/tallbike'),
      import('gsap'),
      import('gsap/ScrollTrigger'),
    ]);
    gsap.registerPlugin(ScrollTrigger);
    const hero = createHero({
      container: canvasBox,
      overlay,
      ink: cssVar('--ink'),
      accent: '#ff4f00',
      reduced,
      small: small(),
    });

    const ro = new ResizeObserver(() => hero.resize());
    ro.observe(canvasBox);

    const recolor = () => hero.setColors(cssVar('--ink'), '#ff4f00');
    window.addEventListener('themechange', recolor);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);

    new IntersectionObserver(([e]) => hero.setActive(e.isIntersecting)).observe(section);

    if (reduced) {
      // straight to the end state of the scroll story: drawing aside, clip shown (desktop only)
      view.textContent = 'assembled view';
      if (!small()) hero.setShift(1);
      return;
    }

    ScrollTrigger.create({
      trigger: section,
      start: 'top top',
      end: 'bottom bottom',
      onUpdate: (st) => {
        const p = st.progress;
        if (p > 0.4) loadPoster();
        hero.setProgress(p / 0.78);
        const r = gsap.utils.clamp(0, 1, (p - 0.8) / 0.17);
        hero.setShift(r);
        reveal(r);
        cue.style.opacity = String(1 - gsap.utils.clamp(0, 1, p * 12));
        view.textContent = p > 0.5 ? 'assembled view' : 'exploded view';
      },
    });

    if (finePointer()) {
      section.addEventListener('pointermove', (e) => {
        const r = section.getBoundingClientRect();
        hero.pointer(((e.clientX - r.left) / r.width) * 2 - 1, ((e.clientY - r.top) / r.height) * 2 - 1);
      });
      section.addEventListener('pointerleave', () => hero.pointer(0, 0));
    } else {
      // touch: horizontal drag spins the drawing, vertical still scrolls the page
      let lastX = 0;
      canvasBox.addEventListener('pointerdown', (e) => (lastX = e.clientX));
      canvasBox.addEventListener('pointermove', (e) => {
        if (e.pointerType === 'mouse' && e.buttons === 0) return;
        hero.drag(e.clientX - lastX);
        lastX = e.clientX;
      });
    }
  }

  if (reduced) reveal(1);
  // don't block first paint: the headline is the LCP, the drawing comes right after
  if ('requestIdleCallback' in window) requestIdleCallback(() => boot(), { timeout: 600 });
  else setTimeout(boot, 120);
</script>

<style>
  .hero {
    position: relative;
  }
  /* the tall track is only there when JS drives the scroll story */
  :global(.js) .hero {
    height: 320svh;
  }
  .hero__stage {
    position: relative;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
  }
  :global(.js) .hero__stage {
    position: sticky;
    top: 0;
  }

  .hero__meta {
    position: absolute;
    top: calc(var(--frame) + 4.4rem);
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    z-index: 2;
  }

  .hero__canvas {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
  }
  .hero__overlay {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }
  .hero__overlay :global(.hero-leaders) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__overlay :global(.hero-leaders line) {
    stroke: var(--ink-3);
    stroke-width: 1;
  }
  .hero__overlay :global(.hero-label),
  .hero__overlay :global(.hero-dim) {
    position: absolute;
    top: 0;
    left: 0;
    white-space: nowrap;
    will-change: transform;
    font-size: 10.5px;
  }
  .hero__overlay :global(.hero-label) {
    padding: 0.15rem 0.35rem;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .hero__overlay :global(.hero-dim) {
    background: var(--bg);
    padding: 0.1rem 0.3rem;
  }

  .hero__copy {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + var(--gutter) + 1rem);
    z-index: 2;
    pointer-events: none;
  }
  .hero__who {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin-bottom: 1.1rem;
  }
  .hero__title {
    /* two sentences, two lines, edge to edge: sized off the viewport so it never wraps on desktop */
    font-size: min(7.4rem, 6.35vw);
    letter-spacing: -0.035em;
    font-variation-settings: 'wdth' 90;
  }
  .hero__line {
    display: block;
  }
  /* line 2 waits in pencil until the skate clip shows up, then gets inked */
  .hero__line--2 {
    --r: 0;
    color: color-mix(in srgb, var(--ink) calc(28% + var(--r) * 72%), transparent);
  }
  :global(.no-js) .hero__line--2,
  .hero--static .hero__line--2 {
    --r: 1;
  }

  .hero__plate {
    --r: 0;
    position: absolute;
    z-index: 2;
    right: calc(var(--frame) + var(--gutter));
    top: calc(var(--frame) + 7rem);
    /* stays above the headline banner */
    height: max(240px, min(calc(100svh - var(--frame) * 2 - 7rem - 6.35vw * 2 - 9rem), 32vw * 16 / 9));
    aspect-ratio: 9 / 16;
    clip-path: inset(calc((1 - var(--r)) * 100%) 0 0 0);
    visibility: hidden;
  }
  .hero__plate[data-shown],
  :global(.no-js) .hero__plate,
  .hero--static .hero__plate {
    visibility: visible;
  }
  :global(.no-js) .hero__plate,
  .hero--static .hero__plate {
    --r: 1;
  }
  .hero__plate video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
    background: var(--bg-raised);
  }
  .hero__plate figcaption {
    margin-top: 0.6rem;
  }
  .hero__still {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border: 1px solid var(--line-strong);
  }
  :global(.no-js) .hero__plate .plate-btn {
    display: none;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--frame) + 1.25rem);
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 0.6rem;
    z-index: 2;
    color: var(--ink-3);
  }
  .hero__cue-line {
    width: 1px;
    height: 28px;
    background: var(--ink-3);
    transform-origin: top;
    animation: cue 1.8s var(--ease-in-out) infinite;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
    }
    50% {
      transform: scaleY(1);
      transform-origin: top;
    }
    51% {
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }
  :global(.no-js) .hero__cue,
  :global(.no-js) .hero__meta {
    display: none;
  }

  @media (max-width: 760px) {
    :global(.js) .hero {
      height: 260svh;
    }
    .hero__meta {
      top: calc(var(--frame) + 3.6rem);
      flex-direction: column;
      gap: 0.2rem;
    }
    .hero__title {
      font-size: clamp(2.5rem, 12vw, 4rem);
      letter-spacing: -0.03em;
    }
    .hero__plate {
      top: calc(var(--frame) + 6.5rem);
      right: 50%;
      /* never taller than the gap between the meta row and the headline */
      height: min(46vw * 16 / 9, 390px, 100svh - 27rem);
      transform: translateX(50%);
    }
    .hero__plate figcaption {
      font-size: 9.5px;
    }
    .hero__cue {
      display: none;
    }
    .hero__overlay :global([data-desktop-only]) {
      display: none;
    }
    .hero__overlay :global(.hero-label),
    .hero__overlay :global(.hero-dim) {
      font-size: 9px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero {
      height: auto;
    }
    /* phones have no room for drawing + clip side by side without the scroll story */
    @media (max-width: 760px) {
      .hero__plate {
        display: none;
      }
    }
    .hero__cue {
      display: none;
    }
  }
</style>
