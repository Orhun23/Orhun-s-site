---
// A calm, type-led hero. The motion is the arrival: on the first visit of a session the sheet
// draws itself (Intro.astro), then this settles in and stays still. One orange dimension line
// measures the headline and drops down as the cue to scroll.
import { site, person } from '../data/site';

const [line1, line2] = site.heroLine;
---

<section id="top" class="hero" data-sheet="01" data-sheet-title="General arrangement">
  <div class="hero__meta mono">
    <span><span class="accent">Fig. 01</span> — General arrangement</span>
    <span class="mono-meta hero__where">{person.base} · {person.coords} · <time data-clock>--:--</time></span>
  </div>

  <div class="hero__body">
    <p class="hero__who mono">
      <span>{person.name}</span>
      <span class="mono-meta">— {person.role}</span>
    </p>
    <h1 class="hero__title display">
      <span class="hero__line">{line1}</span>
      <span class="hero__line">{line2}</span>
    </h1>
    <a class="dimline" href="#status">
      <span class="dimline__h" aria-hidden="true"></span>
      <span class="dimline__label mono">
        <span aria-hidden="true">↓</span> 6 sheets · scroll
      </span>
    </a>
  </div>

  <span class="hero__drop" aria-hidden="true"><span class="hero__pulse"></span></span>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
    min-height: 560px;
    max-height: 1200px;
    padding: calc(var(--frame) + 4.4rem) calc(var(--frame) + var(--gutter)) 0;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
  }

  /* the headline block sits a little below centre: lots of paper above it */
  .hero__body {
    align-self: center;
    width: fit-content;
    max-width: 100%;
    padding-top: 6svh;
  }
  .hero__who {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    margin-bottom: 1.4rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 7.2vw, 8.4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.93;
  }
  .hero__line {
    display: block;
  }

  /* dimension line: measures the headline block, tick at each end, label in the middle */
  .dimline {
    position: relative;
    display: grid;
    place-items: center;
    margin-top: clamp(1.4rem, 3svh, 2.4rem);
    height: 2.2rem;
    text-decoration: none;
    color: var(--accent-text);
  }
  .dimline__h {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background: var(--accent);
  }
  .dimline__h::before,
  .dimline__h::after {
    content: '';
    position: absolute;
    top: -6px;
    width: 1px;
    height: 13px;
    background: var(--accent);
    transform: rotate(45deg);
  }
  .dimline__h::before {
    left: 0;
  }
  .dimline__h::after {
    right: 0;
  }
  .dimline__label {
    position: relative;
    padding: 0.2rem 0.6rem;
    background: var(--bg);
  }
  @media (hover: hover) and (pointer: fine) {
    .dimline__label {
      transition: color var(--dur-hover) ease;
    }
    .dimline:hover .dimline__label {
      color: var(--ink);
    }
  }

  /* from the middle of the dimension line straight down off the sheet: the way on */
  .hero__drop {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: 1px;
    height: 18svh;
    background: linear-gradient(var(--accent), transparent);
    overflow: hidden;
  }
  .hero__pulse {
    position: absolute;
    left: -1px;
    top: 0;
    width: 3px;
    height: 28%;
    background: var(--accent);
    transform: translateY(-100%);
    animation: drop 2.4s var(--ease-in-out) 1.2s infinite;
  }
  @keyframes drop {
    0% {
      transform: translateY(-100%);
    }
    60%,
    100% {
      transform: translateY(400%);
    }
  }

  /* the arrival: Intro.astro sets [data-intro] on <html> and removes it when the sheet lifts */
  .hero__body {
    transition: transform 700ms var(--ease-out);
  }
  .dimline__h {
    transition: transform 700ms var(--ease-in-out) 200ms;
  }
  .dimline__label,
  .hero__drop {
    transition: opacity 400ms ease 600ms;
  }
  :global(html[data-intro]) .hero__body {
    transform: translateY(16px);
  }
  :global(html[data-intro]) .dimline__h {
    transform: scaleX(0);
  }
  :global(html[data-intro]) .dimline__label,
  :global(html[data-intro]) .hero__drop {
    opacity: 0;
  }

  @media (max-width: 760px) {
    .hero {
      padding-top: calc(var(--frame) + 3.6rem);
    }
    .hero__where {
      display: none;
    }
    .hero__title {
      font-size: clamp(2.5rem, 12.5vw, 4.4rem);
    }
    .hero__body {
      align-self: end;
      padding-bottom: 22svh;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__pulse {
      display: none;
    }
    .hero__body,
    .dimline__h,
    .dimline__label,
    .hero__drop {
      transition: none;
    }
  }
</style>

<script>
  // line the drop up with the middle of the dimension line (the headline is content-sized)
  const hero = document.querySelector<HTMLElement>('.hero');
  const dim = hero?.querySelector<HTMLElement>('.dimline');
  const drop = hero?.querySelector<HTMLElement>('.hero__drop');
  if (hero && dim && drop) {
    const place = () => {
      const h = hero.getBoundingClientRect();
      const d = dim.getBoundingClientRect();
      drop.style.left = `${(d.left + d.width / 2 - h.left).toFixed(1)}px`;
      drop.style.height = `${Math.max(40, h.bottom - d.bottom).toFixed(1)}px`;
    };
    place();
    new ResizeObserver(place).observe(hero);
    document.fonts?.ready.then(place);
  }
</script>
