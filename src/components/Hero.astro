---
import { site, person } from '../data/site';
import { STOPS } from '../scripts/hero/machine';

const [line1, line2] = site.heroLine;

// Callouts sit in the machine's 1600×640 design space; the engine moves them with the drawing.
type Label = {
  stage: string;
  at: [number, number];
  code: string;
  text: string;
  sub?: string;
  anchor?: 'left' | 'right';
  code2?: string;
};
const labels: Label[] = [
  { stage: 's1', at: [164, 52], code: 'S-01', text: 'Hopper', sub: 'Input: one ball' },
  { stage: 's2', at: [222, 268], code: 'S-02', text: 'Alps run', sub: '47.33°N 12.36°E' },
  { stage: 's2b', at: [262, 168], code: 'Strobe', text: 'Backflip, every 2nd frame @ 1/12 s', sub: 'Airtime ≈ 0.7 s · rot 360°' },
  { stage: 's3', at: [560, 620], code: 'S-03', text: 'Skate pop', sub: 'Trocadéro rail, 48.86°N 2.29°E' },
  { stage: 's4', at: [800, 252], code: 'S-04', text: 'Iron Man helmet, 360° servo', code2: 'while (!open) step();' },
  { stage: 's5', at: [1010, 620], code: 'S-05', text: 'Tallbike wheel', sub: '2 donor frames, 1 wheel here' },
  { stage: 's6', at: [1236, 620], code: 'S-06', text: 'Own 3D printer', sub: 'CoreXY · Klipper · prints a plane' },
  { stage: 's7', at: [742, 96], code: 'S-07', text: 'Route', sub: '8 stops, 1 paper plane' },
  { stage: 'home', at: [1548, 96], code: 'EIN', text: 'Home', sub: '51.44°N 5.47°E', anchor: 'right' },
];
---

<section id="top" class="hero" data-sheet="01" data-sheet-title="General arrangement" data-hero>
  <div class="hero__meta">
    <p class="mono">
      <span class="accent">Fig. 01</span> — The machine <span class="mono-meta">· 7 stages · 1 ball · real footage</span>
    </p>
    <div class="hero__controls">
      <p class="hero__hint mono mono-meta">
        <span class="hint-fine">Click the drawing to drop a ball</span><span class="hint-touch"
          >Tap to drop a ball · drag to look around</span
        >
      </p>
      <button class="btn hero__replay" type="button" data-replay data-magnetic="0.2">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true"
          ><path d="M13 8a5 5 0 1 1-1.6-3.7M13 2.5v3h-3" fill="none" stroke="currentColor" stroke-width="1.5"
          ></path></svg
        >
        <span data-replay-label>Replay</span>
      </button>
    </div>
  </div>

  <figure class="hero__machine" data-machine>
    <div class="hero__canvas" data-machine-canvas></div>
    <div class="hero__labels" aria-hidden="true">
      {
        labels.map((l) => (
          <div class:list={['mlabel', `mlabel--${l.anchor ?? 'left'}`]} data-at={l.at.join(',')} data-stage={l.stage}>
            <span class="mlabel__box mono">
              <span>
                <span class="accent">{l.code}</span> {l.text}
              </span>
              {l.sub && <span class="mlabel__sub mono-meta">{l.sub}</span>}
              {l.code2 && <code class="mlabel__code">{l.code2}</code>}
            </span>
          </div>
        ))
      }
      {
        STOPS.map((s, i) => (
          <div class="mstop mono" data-at={`${s.x},28`} data-stop={i}>
            <span>{s.code}</span>
          </div>
        ))
      }
    </div>
    <figcaption class="visually-hidden">
      A drawn chain-reaction machine. A ball drops from a hopper, rolls down an Alpine slope and off a snowboard kicker,
      next to a strobe sequence of Orhun doing a backflip on a snowboard. It lands on a skateboard, which pops and hits a
      button, next to a strobe of Orhun skating the Trocadéro rail in Paris. The button opens the faceplate of his Iron
      Man helmet, which pulls a string that spins a tallbike wheel, whose chain drives his home-built 3D printer. The
      printer prints a paper plane that flies a route through Praia, Marrakech, Paris, Istanbul, Delhi, Lombok and Tokyo,
      and lands at Eindhoven.
    </figcaption>
    <noscript>
      <img class="hero__static" src="/media/hero/machine-static.png" alt="" width="1600" height="640" />
    </noscript>
  </figure>

  <div class="hero__copy">
    <p class="hero__who mono">
      <span>{person.name}</span>
      <span class="mono-meta">— {person.role}, {person.base}</span>
    </p>
    <h1 class="hero__title display">
      <span class="hero__line">{line1}</span>
      <span class="hero__line hero__line--2" data-hero-line2>{line2}</span>
    </h1>
  </div>
</section>

<script>
  import { reducedMotion, cssVar, swapText } from '../scripts/env';

  const section = document.querySelector<HTMLElement>('[data-hero]')!;
  const box = section.querySelector<HTMLElement>('[data-machine-canvas]')!;
  const machineEl = section.querySelector<HTMLElement>('[data-machine]')!;
  const labels = [...section.querySelectorAll<HTMLElement>('.mlabel, .mstop')];
  const line2 = section.querySelector<HTMLElement>('[data-hero-line2]')!;
  const replayBtn = section.querySelector<HTMLButtonElement>('[data-replay]')!;
  const replayLabel = section.querySelector<HTMLElement>('[data-replay-label]')!;
  const reduced = reducedMotion();
  if (reduced) swapText(replayLabel, 'Run the machine');

  async function boot() {
    const { createMachine } = await import('../scripts/hero/machine');
    const m = createMachine({
      container: box,
      labels,
      ink: cssVar('--ink'),
      accent: cssVar('--accent'),
      reduced,
      onStage: (stage) => {
        for (const l of labels) l.classList.toggle('is-current', l.dataset.stage === stage);
      },
      onFinale: () => line2.classList.add('is-inked'),
    });

    new ResizeObserver(() => m.resize()).observe(box);
    const recolor = () => m.setColors(cssVar('--ink'), cssVar('--accent'));
    window.addEventListener('themechange', recolor);
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
    new IntersectionObserver(([e]) => m.setActive(e.isIntersecting)).observe(section);

    replayBtn.addEventListener('click', () => {
      line2.classList.remove('is-inked');
      m.replay();
    });

    // tap/click drops a ball; a horizontal drag pans the drawing on phones
    let down: { x: number; y: number; lastX: number; moved: boolean } | null = null;
    machineEl.addEventListener('pointerdown', (e) => {
      down = { x: e.clientX, y: e.clientY, lastX: e.clientX, moved: false };
    });
    machineEl.addEventListener('pointermove', (e) => {
      if (!down) return;
      if (Math.abs(e.clientX - down.x) > 6) down.moved = true;
      if (down.moved) m.pan(e.clientX - down.lastX);
      down.lastX = e.clientX;
    });
    machineEl.addEventListener('pointerup', (e) => {
      if (down && !down.moved && Math.abs(e.clientY - down.y) < 8) m.drop(e.clientX, e.clientY);
      down = null;
    });
    machineEl.addEventListener('pointercancel', () => (down = null));
  }

  // the headline paints first; the machine (≈20 KB) loads right after
  if ('requestIdleCallback' in window) requestIdleCallback(() => boot(), { timeout: 500 });
  else setTimeout(boot, 100);
</script>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(0.75rem, 2svh, 1.5rem);
    height: 100svh;
    min-height: 600px;
    max-height: 1100px;
    padding: calc(var(--frame) + 4.2rem) calc(var(--frame) + var(--gutter)) calc(var(--frame) + 2.6rem);
  }

  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .hero__controls {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
  .hero__replay {
    padding: 0.55em 0.9em;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  :global(.no-js) .hero__controls {
    display: none;
  }

  .hero__machine {
    position: relative;
    min-height: 0;
    overflow: hidden;
    cursor: crosshair;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .hero__canvas,
  .hero__labels {
    position: absolute;
    inset: 0;
  }
  .hero__labels {
    pointer-events: none;
  }
  .hero__static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* callouts: appear as their stage fires */
  .mlabel,
  .mstop {
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }
  .mlabel__box {
    position: absolute;
    top: 0;
    display: grid;
    gap: 0.1rem;
    padding: 0.25rem 0.45rem;
    font-size: 10.5px;
    white-space: nowrap;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    border: 1px solid var(--line-strong);
    translate: 0 -50%;
    opacity: 0;
    transition: opacity 260ms var(--ease-out);
  }
  .mlabel--right .mlabel__box {
    right: 0;
  }
  .mlabel__sub {
    font-size: 9.5px;
  }
  .mlabel__code {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--accent-text);
    text-transform: none;
  }
  .mlabel.is-on .mlabel__box,
  :global(.no-js) .mlabel__box {
    opacity: 1;
  }
  .mstop span {
    position: absolute;
    translate: -50% -50%;
    font-size: 10px;
    color: var(--ink-3);
    transition: color 200ms ease;
  }
  .mstop.is-on span {
    color: var(--accent-text);
  }

  .hero__who {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.6rem;
    margin-bottom: 0.8rem;
  }
  .hero__title {
    font-size: clamp(2.4rem, 5.1vw, 6rem);
    letter-spacing: -0.04em;
    line-height: 0.95;
    font-weight: 800;
  }
  .hero__line {
    display: block;
  }
  /* line 2 waits in pencil until the plane lands, then gets inked with an orange underline */
  .hero__line--2 {
    position: relative;
    width: fit-content;
    color: color-mix(in srgb, var(--ink) 30%, transparent);
    transition: color 700ms var(--ease-out);
  }
  .hero__line--2::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0.3em;
    bottom: -0.04em;
    height: 0.07em;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 700ms var(--ease-in-out) 150ms;
  }
  .hero__line--2.is-inked,
  :global(.no-js) .hero__line--2 {
    color: var(--ink);
  }
  .hero__line--2.is-inked::after,
  :global(.no-js) .hero__line--2::after {
    transform: scaleX(1);
  }

  /* when the drawing pans (phones, portrait tablets) only the active callout shows */
  .hero__machine[data-pannable] .mlabel:not(.is-current) {
    display: none;
  }

  /* phones */
  @media (max-width: 760px) {
    .hero {
      padding-top: calc(var(--frame) + 3.6rem);
      padding-bottom: calc(var(--frame) + 2.4rem);
      min-height: 560px;
    }
    .hero__title {
      font-size: clamp(2.3rem, 11vw, 3.6rem);
    }
    .mlabel__box {
      font-size: 9.5px;
    }
    .hero__hint {
      font-size: 9.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mlabel__box,
    .hero__line--2,
    .hero__line--2::after {
      transition: none;
    }
  }
</style>
