---
// The hero: a contact sheet of everything (builds, boards, trips) drifting up the paper, dimmed,
// with the line sitting on the sheet in front of it. The type reacts to the cursor
// (scripts/hero/kinetic.ts); the frames light up when you go to them. Scrolling lays the wall
// flat and the first section takes over.
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { site, person } from '../data/site';

const m = import.meta.glob<{ default: ImageMetadata }>('../assets/media/**/*.jpg', { eager: true });
const img = (p: string) => m[`../assets/media/${p}.jpg`].default;

type Tile = { src: string; tag: string; label: string; video?: string };
const raw: [string, string, string, string?][] = [
  ['builds/tallbike/riding', 'B-01', 'Tallbike', '/media/builds/tallbike/riding.mp4'],
  ['trips/rinjani-ridge', 'T-01', 'Rinjani 8.41°S'],
  ['field/snow-jump', 'S-02', 'Snow', '/media/field/snow-jump.mp4'],
  ['builds/helmet/clean', 'B-02', 'Iron Man helmet'],
  ['trips/osaka-night', 'T-02', 'Osaka'],
  ['field/skate-trocadero', 'S-01', 'Trocadéro', '/media/field/skate-trocadero.mp4'],
  ['builds/xwing/clean', 'B-03', 'X-wing'],
  ['trips/sahara', 'T-03', 'Sahara'],
  ['builds/printer/printing', 'B-04', '3D printer', '/media/builds/printer/printing.mp4'],
  ['field/surf', 'S-03', 'Surf, Lombok'],
  ['trips/fuji-summit', 'T-02', 'Fuji 3776 m'],
  ['builds/tallbike/welding', 'B-01', 'Welding', '/media/builds/tallbike/welding.mp4'],
  ['field/skate-bowl-air', 'S-01', 'Taghazout bowl'],
  ['trips/fogo', 'T-04', 'Fogo'],
  ['builds/helmet/faceplate', 'B-02', 'Faceplate servo', '/media/builds/helmet/faceplate.mp4'],
  ['field/backfull', 'S-04', 'Backfull', '/media/field/backfull.mp4'],
  ['trips/jaipur-wall', 'T-05', 'Jaipur'],
  ['builds/xwing/exploded', 'B-03', 'Exploded view'],
  ['field/snow-spray', 'S-02', 'Powder'],
  ['trips/todra-gorge', 'T-03', 'Todra gorge'],
  ['trips/whale-shark', 'T-01', 'Whale shark', '/media/trips/whale-shark.mp4'],
  ['builds/printer/frame-cad', 'B-04', 'Frame CAD'],
  ['trips/black-beach', 'T-04', 'Black beach'],
  ['builds/tallbike/jig', 'B-01', 'On the jig'],
];
const tiles: Tile[] = await Promise.all(
  raw.map(async ([path, tag, label, video]) => {
    const r = await getImage({ src: img(path), width: 300, height: 375, fit: 'cover', format: 'webp', quality: 62 });
    return { src: r.src, tag, label, video };
  }),
);
const COLS = 6;
// columns drift at their own speed; each list is repeated so the loop is seamless
const cols = Array.from({ length: COLS }, (_, c) => tiles.filter((_, i) => i % COLS === c));

const [line1, line2] = site.heroLine;
const words = (line: string) => line.split(' ');
---

<section id="top" class="hero" data-hero data-sheet="01" data-sheet-title="General arrangement">
  <div class="hero__stage" data-hero-stage>
    <div class="wall" data-wall aria-hidden="true">
      {
        cols.map((col, c) => (
          <div class="wall__col" style={`--d:${46 + ((c * 7) % 5) * 6}s;--o:${-((c * 37) % 100) / 100}`}>
            <div class="wall__track">
              {[...col, ...col, ...col, ...col].map((t, i) => (
                <figure class="tile" data-video={t.video}>
                  <img
                    src={t.src}
                    alt=""
                    width="300"
                    height="375"
                    loading={i < 2 ? 'eager' : 'lazy'}
                    fetchpriority={i < 2 ? 'high' : undefined}
                    decoding="async"
                  />
                  <figcaption class="mono">
                    <span class="accent">{t.tag}</span> {t.label}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))
      }
    </div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__copy" data-hero-copy>
      <p class="hero__who mono">
        <span>{person.name}</span>
        <span class="mono-meta">— {person.role}, {person.base} · {person.coords}</span>
      </p>
      <h1 class="hero__title display" data-kinetic>
        <span class="visually-hidden">{line1} {line2}</span>
        {
          [line1, line2].map((line) => (
            <span class="hero__line" data-k-line aria-hidden="true">
              {words(line).map((w) => (
                <span class="hero__word">
                  {[...w].map((ch) => (
                    <span class="k" data-k>
                      <span class="k__b">{ch}</span>
                      <span class="k__a">{ch}</span>
                    </span>
                  ))}
                </span>
              ))}
            </span>
          ))
        }
      </h1>
      <p class="hero__hint mono mono-meta" aria-hidden="true">
        <span class="hint-fine">Move over the frames to light them up</span>
      </p>
    </div>

    <a class="hero__cue mono" href="#status">↓ Scroll</a>
  </div>
</section>

<script>
  import { reducedMotion, finePointer } from '../scripts/env';
  import { createKinetic } from '../scripts/hero/kinetic';

  const section = document.querySelector<HTMLElement>('[data-hero]')!;
  const stage = section.querySelector<HTMLElement>('[data-hero-stage]')!;
  const wall = section.querySelector<HTMLElement>('[data-wall]')!;
  const copy = section.querySelector<HTMLElement>('[data-hero-copy]')!;
  const title = section.querySelector<HTMLElement>('[data-kinetic]')!;
  const reduced = reducedMotion();
  const fine = finePointer();

  // one shared <video>, moved into whichever clip tile is lit: never more than one decoding
  const player = document.createElement('video');
  player.muted = true;
  player.loop = true;
  player.playsInline = true;
  player.className = 'tile__vid';
  let active: HTMLElement | null = null;
  const activate = (tile: HTMLElement | null) => {
    if (tile === active) return;
    active?.classList.remove('is-on');
    active = tile;
    stage.classList.toggle('is-looking', !!tile);
    if (!tile) {
      player.pause();
      player.remove();
      return;
    }
    tile.classList.add('is-on');
    const v = tile.dataset.video;
    if (v && !reduced) {
      if (!player.src.endsWith(v)) player.src = v;
      tile.appendChild(player);
      player.play().catch(() => {});
    } else {
      player.pause();
      player.remove();
    }
  };

  // the line reacts to the cursor; over the line the frames stay dim so the type leads
  const kinetic = fine && !reduced ? createKinetic(title) : null;
  if (fine) {
    let overText = false;
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      kinetic?.move(e.clientX, e.clientY);
      const r = copy.getBoundingClientRect();
      overText = e.clientX >= r.left && e.clientX <= r.right && e.clientY >= r.top && e.clientY <= r.bottom;
      if (overText) activate(null);
    });
    wall.addEventListener('pointerover', (e) => {
      if (overText) return;
      activate((e.target as Element).closest<HTMLElement>('.tile'));
    });
    stage.addEventListener('pointerleave', () => {
      activate(null);
      kinetic?.leave();
    });
  } else if (!reduced) {
    // touch: no hover, so every so often a frame in the upper half develops on its own
    let i = 0;
    setInterval(() => {
      if (section.classList.contains('is-off') || scrollY > innerHeight * 0.3) return;
      const x = innerWidth * (0.3 + 0.4 * (i++ % 2)),
        y = innerHeight * (0.22 + 0.1 * (i % 3));
      activate(document.elementFromPoint(x, y)?.closest<HTMLElement>('.tile') ?? null);
    }, 1800);
  }

  // scroll: the wall lays flat and dims, the line slides up and out (transform/opacity only)
  if (!reduced) {
    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const r = section.getBoundingClientRect();
          const p = Math.min(1, Math.max(0, -r.top / Math.max(1, r.height - innerHeight)));
          // written straight to the wall: a custom property here would restyle every frame inside it
          wall.style.transform = p
            ? `rotateX(${(26 * (1 - p)).toFixed(2)}deg) rotateZ(${(-6 * (1 - p)).toFixed(2)}deg) translateY(${(-12 * p).toFixed(2)}%) scale(${(1 - p * 0.08).toFixed(4)})`
            : '';
          wall.style.opacity = p ? (1 - p * 0.75).toFixed(3) : '';
          copy.style.transform = p ? `translate3d(0, ${(-p * 80).toFixed(1)}px, 0)` : '';
          copy.style.opacity = p ? String(Math.max(0, 1 - p * 1.8)) : '';
          if (p > 0.05 && active) activate(null);
        });
      },
      { passive: true },
    );
  }
  // offscreen: stop the drift and the type loop
  new IntersectionObserver(([e]) => {
    section.classList.toggle('is-off', !e.isIntersecting);
    kinetic?.setActive(e.isIntersecting);
  }).observe(section);
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
  }
  :global(.js) .hero {
    height: 145svh;
  }
  .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 560px;
    overflow: hidden;
    perspective: 1400px;
  }

  /* ---- the wall ---- */
  .wall {
    position: absolute;
    inset: -30% -8% -30% -8%;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: clamp(10px, 1.4vw, 22px);
    padding-inline: 2vw;
    transform: rotateX(26deg) rotateZ(-6deg);
    transform-origin: 50% 40%;
    will-change: transform;
  }
  .wall__track {
    display: grid;
    gap: clamp(10px, 1.4vw, 22px);
    animation: drift var(--d) linear infinite;
    animation-delay: calc(var(--d) * var(--o));
  }
  .hero.is-off .wall__track {
    animation-play-state: paused;
  }
  @keyframes drift {
    to {
      transform: translateY(-50%);
    }
  }
  .tile {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 5;
    background: var(--bg-raised);
  }
  .tile img,
  .tile :global(.tile__vid) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* dim by default so the line leads; the wall comes up when you go to it, the frame under
     the cursor develops into full colour */
  .tile img {
    filter: grayscale(1) contrast(1.05);
    opacity: 0.38;
    transition:
      filter 450ms ease,
      opacity 450ms ease;
  }
  .hero__stage.is-looking .tile img {
    opacity: 0.6;
  }
  .hero__stage.is-looking .tile.is-on img,
  .tile.is-on img {
    filter: none;
    opacity: 1;
  }
  .tile figcaption {
    position: absolute;
    left: 0;
    top: 100%;
    margin-top: 4px;
    font-size: 9px;
    white-space: nowrap;
    color: var(--ink-3);
    opacity: 0.6;
    transition: opacity 300ms ease;
  }
  .tile.is-on figcaption {
    color: var(--ink);
    opacity: 1;
  }
  .tile.is-on {
    outline: 1px solid var(--accent);
    outline-offset: 3px;
  }

  /* the paper comes up from the bottom-left, under the line: the wall drifts out of it */
  .hero__veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      to top,
      var(--bg) 0%,
      color-mix(in srgb, var(--bg) 82%, transparent) 26%,
      color-mix(in srgb, var(--bg) 0%, transparent) 62%
    );
  }

  /* ---- the line ---- */
  .hero__copy {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 3.4rem);
    pointer-events: none;
  }
  .hero__who {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 0.6rem;
    margin-bottom: 1.2rem;
  }
  .hero__title {
    font-size: clamp(2.6rem, 6.9vw, 8rem);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.92;
  }
  .hero__line {
    display: block;
    white-space: nowrap;
  }
  .hero__word {
    display: inline-block;
    white-space: nowrap;
  }
  /* the gap trails each word, so a wrapped line starts flush */
  .hero__word:not(:last-child) {
    margin-right: 0.24em;
  }
  .k {
    position: relative;
    display: inline-block;
    transform-origin: 50% 60%;
  }
  .k__a,
  .k__b {
    display: inline-block;
  }
  /* the same glyph as a drawing: thin outline underneath the solid one */
  .k__b {
    position: absolute;
    left: 0;
    top: 0;
    color: transparent;
    -webkit-text-stroke: 1px var(--ink);
  }
  .hero__hint {
    margin-top: 1rem;
    font-size: 10px;
  }
  @media (hover: none) {
    .hero__hint {
      display: none;
    }
  }

  .hero__cue {
    position: absolute;
    right: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 3.4rem);
    text-decoration: none;
    font-size: 10px;
    color: var(--accent-text);
  }

  @media (max-width: 760px) {
    .wall {
      grid-template-columns: repeat(3, 1fr);
      inset: -30% -20% -30% -20%;
    }
    .wall__col:nth-child(n + 4) {
      display: none;
    }
    .hero__line {
      white-space: normal;
    }
    .hero__title {
      font-size: clamp(2.4rem, 11.5vw, 4.2rem);
    }
    .hero__copy {
      bottom: calc(var(--frame) + 2.8rem);
    }
    .hero__who .mono-meta {
      flex-basis: 100%;
    }
    .hero__cue {
      display: none;
    }
    .hero__veil {
      background: linear-gradient(
        to top,
        var(--bg) 0%,
        color-mix(in srgb, var(--bg) 85%, transparent) 38%,
        color-mix(in srgb, var(--bg) 0%, transparent) 70%
      );
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero {
      height: 100svh;
    }
    .wall__track {
      animation: none;
    }
  }
</style>
