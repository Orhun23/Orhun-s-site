---
// "Plotted": Orhun drawn as pen-plotter lines (src/scripts/hero/plotted.ts). No headline:
// the hero is something to look at and poke for a second. Scrolling flattens the lines onto
// the sheet's ruled grid, which is the paper every section below sits on.
import { person } from '../data/site';
import subjects from '../data/plot.json';
---

<section id="top" class="hero" data-sheet="01" data-sheet-title="General arrangement" data-hero>
  <div class="hero__stage" data-hero-stage>
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <noscript><img class="hero__static" src="/media/hero/plot-static.png" alt="" /></noscript>

    <h1 class="visually-hidden">{person.name}, {person.role.toLowerCase()} in {person.base}</h1>

    <div class="hero__meta mono">
      <span><span class="accent">Fig. 01</span> — {person.initials}, plotted <span class="mono-meta">· {person.coords}</span></span>
      <button class="hero__next mono" type="button" data-hero-next aria-label="Show the next drawing">
        <span class="mono-meta">Subject</span>
        <span data-hero-count>01</span><span class="mono-meta">/{String(subjects.length).padStart(2, '0')}</span>
        <span data-hero-label>{subjects[0].label}</span>
        <span class="hero__arrow" aria-hidden="true">→</span>
      </button>
    </div>

    <p class="hero__hint mono mono-meta" aria-hidden="true">
      <span class="hint-fine">Move to look closer · click for the next one</span>
      <span class="hint-touch">Touch to look closer · tap for the next one</span>
    </p>
    <a class="hero__cue mono" href="#status">
      <span class="hero__cue-line" aria-hidden="true"></span>
      Scroll
    </a>
  </div>
</section>

<script>
  import { reducedMotion, cssVar, swapText } from '../scripts/env';
  import subjects from '../data/plot.json';

  const section = document.querySelector<HTMLElement>('[data-hero]')!;
  const stage = section.querySelector<HTMLElement>('[data-hero-stage]')!;
  const canvas = section.querySelector<HTMLCanvasElement>('[data-hero-canvas]')!;
  const btn = section.querySelector<HTMLButtonElement>('[data-hero-next]')!;
  const countEl = section.querySelector<HTMLElement>('[data-hero-count]')!;
  const labelEl = section.querySelector<HTMLElement>('[data-hero-label]')!;
  const reduced = reducedMotion();

  (async () => {
    const { createPlotted } = await import('../scripts/hero/plotted');
    const p = await createPlotted({
      canvas,
      subjects,
      reduced,
      colors: () => ({ ink: cssVar('--ink'), accent: cssVar('--accent'), bg: cssVar('--bg') }),
      onSubject: (i) => {
        swapText(countEl, String(i + 1).padStart(2, '0'));
        swapText(labelEl, subjects[i].label);
      },
    });
    section.classList.add('is-live');

    new ResizeObserver(() => p.resize()).observe(stage);
    const recolor = () => p.recolor();
    addEventListener('themechange', recolor);
    matchMedia('(prefers-color-scheme: dark)').addEventListener('change', recolor);
    new IntersectionObserver(([e]) => p.setActive(e.isIntersecting)).observe(section);

    // mouse: the lens follows the pointer; a click anywhere on the drawing is "next"
    const local = (e: { clientX: number; clientY: number }) => {
      const r = canvas.getBoundingClientRect();
      return [e.clientX - r.left, e.clientY - r.top] as const;
    };
    stage.addEventListener('pointermove', (e) => {
      if (e.pointerType !== 'mouse') return;
      // over the controls it's a pointer, not a lens
      if ((e.target as Element).closest('a, button')) p.lensOff();
      else p.lens(...local(e));
    });
    stage.addEventListener('pointerleave', () => p.lensOff());
    stage.addEventListener('click', (e) => {
      if ((e.target as Element).closest('a, button')) return;
      p.next();
    });
    btn.addEventListener('click', () => p.next());

    // touch: the lens sits under the finger while it's down; scrolling still works
    let lift = 0;
    stage.addEventListener(
      'touchmove',
      (e) => {
        clearTimeout(lift);
        p.lens(...local(e.touches[0]));
      },
      { passive: true },
    );
    stage.addEventListener('touchstart', (e) => p.lens(...local(e.touches[0])), { passive: true });
    stage.addEventListener('touchend', () => (lift = window.setTimeout(() => p.lensOff(), 350)), { passive: true });

    // scroll through the sticky hero flattens the drawing onto the grid
    if (!reduced) {
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const r = section.getBoundingClientRect();
          p.setScroll(-r.top / Math.max(1, r.height - innerHeight));
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  })();
</script>

<style>
  .hero {
    position: relative;
    height: 100svh;
  }
  :global(.js) .hero {
    height: 175svh;
  }
  .hero__stage {
    position: sticky;
    top: 0;
    height: 100svh;
    min-height: 520px;
    overflow: hidden;
    cursor: crosshair;
    touch-action: pan-y;
  }
  .hero__canvas,
  .hero__static {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .hero__static {
    object-fit: cover;
  }

  .hero__meta {
    position: absolute;
    top: calc(var(--frame) + 4.4rem);
    left: calc(var(--frame) + var(--gutter));
    right: calc(var(--frame) + var(--gutter));
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.5rem 1rem;
  }
  .hero__next {
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    padding: 0.35rem 0;
    color: var(--ink);
  }
  .hero__arrow {
    color: var(--accent-text);
    transition: transform var(--dur-ui) var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .hero__next:hover .hero__arrow {
      transform: translateX(5px);
    }
  }

  .hero__hint {
    position: absolute;
    left: calc(var(--frame) + var(--gutter));
    bottom: calc(var(--frame) + 1.1rem);
    font-size: 10px;
  }
  .hint-touch {
    display: none;
  }
  @media (hover: none) {
    .hint-fine {
      display: none;
    }
    .hint-touch {
      display: inline;
    }
  }
  :global(.no-js) .hero__hint,
  :global(.no-js) .hero__next {
    display: none;
  }

  .hero__cue {
    position: absolute;
    left: 50%;
    bottom: calc(var(--frame) + 2.6rem);
    transform: translateX(-50%);
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    text-decoration: none;
    font-size: 10px;
    color: var(--accent-text);
    padding: 0.4rem 0.6rem;
    background: var(--bg);
  }
  .hero__cue-line {
    width: 1px;
    height: 28px;
    background: var(--accent);
    transform-origin: top;
    animation: cue 2.2s var(--ease-in-out) 1.8s infinite both;
  }
  @keyframes cue {
    0% {
      transform: scaleY(0);
      transform-origin: top;
    }
    45% {
      transform: scaleY(1);
      transform-origin: top;
    }
    55% {
      transform: scaleY(1);
      transform-origin: bottom;
    }
    100% {
      transform: scaleY(0);
      transform-origin: bottom;
    }
  }

  /* the title block grows wide on tablets: keep the hint above it */
  @media (max-width: 1100px) {
    .hero__hint {
      bottom: calc(var(--frame) + 2.6rem);
    }
  }
  @media (max-width: 760px) {
    .hero__meta {
      top: calc(var(--frame) + 3.6rem);
    }
    .hero__meta > span:first-child .mono-meta {
      display: none;
    }
    .hero__hint {
      left: 50%;
      transform: translateX(-50%);
      white-space: nowrap;
      bottom: calc(var(--frame) + 2.6rem);
    }
    .hero__cue {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .hero {
      height: 100svh;
    }
    .hero__cue-line {
      animation: none;
    }
  }
</style>
