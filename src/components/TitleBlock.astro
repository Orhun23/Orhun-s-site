---
// The title block in the corner of every drawing. Here it doubles as a
// "you are here": the sheet number/title update as sections scroll past.
import { person } from '../data/site';

interface Props {
  sheet: { no: string; title: string; of?: number };
}
const { sheet } = Astro.props;
---

<aside class="tb" aria-label="Drawing info">
  <dl class="tb__grid mono">
    <div class="tb__cell tb__cell--wide">
      <dt>Title</dt>
      <dd data-tb-title>{sheet.title}</dd>
    </div>
    <div class="tb__cell">
      <dt>Sheet</dt>
      <dd><span data-tb-no>{sheet.no}</span>{sheet.of && ` / ${String(sheet.of).padStart(2, '0')}`}</dd>
    </div>
    <div class="tb__cell">
      <dt>Drawn</dt>
      <dd>O.H. Erdogan</dd>
    </div>
    <div class="tb__cell">
      <dt>Rev</dt>
      <dd>{person.age}</dd>
    </div>
    <div class="tb__cell tb__cell--wide">
      <dt>Location</dt>
      <dd>{person.coords} · <time data-clock>--:--</time></dd>
    </div>
  </dl>
</aside>

<style>
  /* a one-row strip sitting on the bottom frame line: reads as a title block, covers almost nothing */
  .tb {
    position: fixed;
    right: var(--frame);
    bottom: var(--frame);
    z-index: 41;
    background: var(--bg);
    border-top: 1px solid var(--line-strong);
    border-left: 1px solid var(--line-strong);
    pointer-events: none;
  }
  .tb__grid {
    display: flex;
    font-size: 9.5px;
  }
  .tb__cell {
    display: flex;
    gap: 0.5em;
    align-items: baseline;
    padding: 0.4rem 0.65rem;
    border-right: 1px solid var(--line);
    white-space: nowrap;
  }
  .tb__cell:last-child {
    border-right: 0;
  }
  /* order: sheet, title, drawn, rev, location */
  .tb__cell:nth-child(2) {
    order: -1;
  }
  dt {
    color: var(--ink-3);
  }
  dd {
    color: var(--ink);
  }
  [data-tb-title] {
    display: inline-block;
    min-width: 17ch;
  }

  @media (max-width: 1100px) {
    .tb__cell:nth-child(3),
    .tb__cell:nth-child(4) {
      display: none;
    }
  }
  /* phones: sheet + title only */
  @media (max-width: 720px) {
    .tb__cell:nth-child(5) {
      display: none;
    }
    .tb__cell {
      padding: 0.35rem 0.55rem;
    }
    dt {
      display: none;
    }
    [data-tb-title] {
      min-width: 0;
    }
  }
  @media print {
    .tb {
      display: none;
    }
  }
</style>
