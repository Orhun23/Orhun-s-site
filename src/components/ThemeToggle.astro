---
// Cycles system → light → dark. Remembers the choice per browser.
---

<button class="theme press" type="button" data-theme-toggle aria-label="Colour theme: system">
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.25"></circle>
    <path class="theme__half" d="M10 2.75a7.25 7.25 0 0 1 0 14.5z" fill="currentColor"></path>
    <path d="M10 0v3M10 17v3M0 10h3M17 10h3" stroke="currentColor" stroke-width="1.25"></path>
  </svg>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;
  const order = ['system', 'light', 'dark'] as const;
  type Mode = (typeof order)[number];

  const current = (): Mode => (root.dataset.theme as Mode) ?? 'system';
  const label = (m: Mode) => btn?.setAttribute('aria-label', `Colour theme: ${m}. Click to change.`);

  label(current());
  btn?.addEventListener('click', () => {
    const next = order[(order.indexOf(current()) + 1) % order.length];
    if (next === 'system') delete root.dataset.theme;
    else root.dataset.theme = next;
    try {
      if (next === 'system') localStorage.removeItem('theme');
      else localStorage.setItem('theme', next);
    } catch {}
    label(next);
    window.dispatchEvent(new CustomEvent('themechange'));
  });
</script>

<style>
  .theme {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    margin: -6px -6px -6px 0;
    border-radius: 50%;
    color: var(--ink);
  }
  .theme__half {
    transform-origin: 10px 10px;
    transition: transform var(--dur-ui) var(--ease-out);
  }
  :global([data-theme='light']) .theme__half {
    transform: rotate(180deg);
  }
  :global([data-theme='dark']) .theme__half {
    transform: rotate(90deg);
  }
</style>
